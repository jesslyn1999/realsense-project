<?xml version="1.0"?>
<package format="3">
  <name>object_scanner_processing</name>
  <version>0.1.0</version>
  <description>Hardware-independent refinement of recorded object-scanner point clouds.</description>
  <maintainer email="jess@example.com">jess</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-open3d</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-sklearn</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
